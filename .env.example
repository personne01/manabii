# Local development environment template.
# Copy to .env and fill in real values: cp .env.example .env
# This file is committed; never put real credentials here.
#
# WARNING: the auth values below are NON-SECRET PLACEHOLDERS so that a fresh
# clone can build, boot, and be reviewed without real Google OAuth credentials.
# They let `npm run dev` and `npm run build` succeed locally; they will NOT
# complete a real Google sign-in. Replace all four auth values in any shared or
# deployed environment before that environment receives traffic.

# PostgreSQL connection string.
# Password-less local example: postgresql://manabii@127.0.0.1:5432/manabii?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# PostgreSQL connection string for the automated integration suite ONLY.
# It must point at a dedicated, throwaway test database — never at the
# development or production DATABASE_URL. The suite writes rows and deletes
# them, but it must never share a database with real users.
#
# Create and migrate it once:
#   createdb manabii_test
#   DATABASE_URL="<this value>" npx prisma migrate deploy
#
# Unlike DATABASE_URL, do NOT append `?schema=public`: this value is handed to
# node-postgres via @prisma/adapter-pg, which rejects unknown URI query
# parameters with "invalid URI query parameter: schema".
#
# When this variable is unset the integration suite is SKIPPED, not passed. CI
# must set it for those assertions to count.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/manabii_test"

# --- Auth.js v4 (next-auth@4.24.15), Google OAuth first ---
# Canonical origin of this app, no trailing slash. Must match the redirect URI
# registered in the Google Cloud console.
NEXTAUTH_URL="http://localhost:3000"

# Session cookie signing secret. Generate a real one with: openssl rand -base64 32
# next-auth rejects an empty value in production, and lib/auth.ts fails fast by
# name when a required variable is unset or empty.
NEXTAUTH_SECRET="placeholder-generate-with-openssl-rand-base64-32"

# Google OAuth client credentials, from
# https://console.cloud.google.com/apis/credentials
# The Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="placeholder-local-dev-client-id"
GOOGLE_CLIENT_SECRET="placeholder-local-dev-client-secret"